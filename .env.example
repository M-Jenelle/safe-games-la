# Claude question interpretation. The key stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: only the map needs this browser key (restrict its referrers).
GOOGLE_MAPS_API_KEY=

# Ticketmaster Discovery API key. Keep this in .env.local; do not commit it.
TICKETMASTER_API_KEY=

# LA Metro GTFS-realtime alerts, served by Swiftly. Request the key from
# https://developer.metro.net/api/ . Without it, chat says the feed is not connected.
SWIFTLY_API_KEY=
