# Claude on Vertex AI. Sign-in is Application Default Credentials
# (`gcloud auth application-default login`), not an API key.
# Enable Claude Haiku 4.5 in Model Garden for this project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-east5
ANTHROPIC_MODEL=claude-haiku-4-5@20251001

# Optional: only the map needs this browser key (restrict its referrers).
GOOGLE_MAPS_API_KEY=

# Ticketmaster Discovery API key. Keep this in .env.local; do not commit it.
TICKETMASTER_API_KEY=

# LA Metro GTFS-realtime alerts, served by Swiftly. Request the key from
# https://developer.metro.net/api/ . Without it, chat says the feed is not connected.
SWIFTLY_API_KEY=
