# Gemini classifies questions. Python calculates the counts.
# Sign in with: gcloud auth application-default login
# The account needs roles/aiplatform.user on this project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-west1
GEMINI_MODEL=gemini-2.5-flash

# Optional. Used only by scripts/compare_models.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# The map needs this browser key. Restrict its referrers to the site origin.
GOOGLE_MAPS_API_KEY=

# Ticketmaster Discovery API key. Keep this in .env.local; do not commit it.
TICKETMASTER_API_KEY=

# LA Metro GTFS-realtime alerts, served by Swiftly. Request the key from
# https://developer.metro.net/api/ . Without it, chat says the feed is not connected.
SWIFTLY_API_KEY=
